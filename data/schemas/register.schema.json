{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "register.schema.json",
  "title": "HELM Data Register (SP-1 output)",
  "type": "object",
  "required": ["engagement", "ref", "data_shape", "synthetic", "fields", "headlines"],
  "properties": {
    "engagement": {"type": "string"},
    "ref": {"type": "string"},
    "generated": {"type": "string"},
    "data_shape": {"enum": ["status-grid", "telemetry", "text-heavy", "relationship-graph", "threat-network", "multi-unit", "clinical", "public-facing", "long-time-series", "evidence-board", "entertainment", "time-series", "categorical", "hierarchy", "geospatial", "flow", "mixed"]},
    "synthetic": {"type": "boolean"},
    "synthetic_assumptions": {"type": "array", "items": {"type": "string"}},
    "fields": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "source", "quality", "role", "evidence"],
        "properties": {
          "name": {"type": "string"},
          "type": {"enum": ["number", "integer", "string", "date", "datetime", "boolean", "enum", "geo"]},
          "cardinality": {"type": "integer"},
          "null_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "units": {"type": "string"},
          "source": {"type": "string"},
          "quality": {"enum": ["clean", "degraded", "blocked"]},
          "role": {"enum": ["kpi", "dimension", "context", "not-shown"]},
          "zone": {"enum": ["prime", "support", "context", "stream", "control", "status_rail", "not-shown"]},
          "evidence": {"enum": ["VERIFIED", "CORROBORATED", "UNCORROBORATED", "INFERENCE", "STATED"]}
        }
      }
    },
    "headlines": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "required": ["field", "rank", "why"]}},
    "quality_flags": {"type": "array", "items": {"type": "object", "required": ["flag", "severity"], "properties": {"severity": {"enum": ["blocks", "degrades", "cosmetic"]}}}}
  }
}
